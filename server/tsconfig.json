{
  "//": "Type-checks the development AI server and the shared AI code it imports: npx tsc -p server",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "jest"]
  },
  "include": ["./**/*.ts", "../supabase/functions/_shared/ai/**/*.ts"]
}
