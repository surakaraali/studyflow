# Copy to .env.local. Without Supabase values the app runs in local mode (data on device only).

# Supabase (EU region project). The anon key is public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local mode: where the development AI server listens (npm run ai:dev).
# The iOS simulator reaches the Mac at 127.0.0.1; a phone needs the Mac's LAN address.
# Ignored in release builds.
EXPO_PUBLIC_AI_DEV_URL=http://127.0.0.1:8787

# RevenueCat public SDK keys (not secret).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Parent consent web page and support address.
EXPO_PUBLIC_CONSENT_WEB_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# EAS project id from `eas init` (not secret, not EXPO_PUBLIC_). app.config.ts reads it for the
# update URL and extra.eas.projectId. EAS CLI does not read .env files: export it in the shell or
# CI wherever `eas build` / `eas update` runs. EAS build workers fall back to EAS_BUILD_PROJECT_ID.
# EAS_PROJECT_ID=

# --- Server only: never prefix these with EXPO_PUBLIC_ ---
# Used by server/dev-ai.ts and the Supabase Edge Functions.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Edge Function secrets (set with `supabase secrets set`, not in .env.local).
# Sign in with Apple token revoke on account deletion (App Store rule 5.1.1(v)).
# Without them the account is still deleted and the skipped revoke is logged.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=        # contents of the .p8 key
# APPLE_CLIENT_ID=com.cobanov.studyflow

# First-party telemetry and ops alerts (ADR-006).
# TELEMETRY_HASH_SALT: random secret, at least 16 characters (e.g. `openssl rand -hex 32`). Keys the
# telemetry function's per-user hourly rate limit; without it the function answers 500.
# TELEMETRY_HASH_SALT=
# OPS_ALERT_EMAIL: where ops-alerts sends OBS-03 alerts (team inbox). Without it alerts only go to
# the function log. ops-alerts also needs CRON_SECRET (same value as Vault 'cron_secret').
# OPS_ALERT_EMAIL=
# AI_MONTHLY_BUDGET_USD: monthly AI budget; process-document warns and ops-alerts e-mails at 80%
# and 100%. Default 250.
# AI_MONTHLY_BUDGET_USD=250
