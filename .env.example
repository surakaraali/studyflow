# Copy to .env.local. Without Supabase values the app runs in local mode (data on device only).

# Supabase (EU region project). The anon key is public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local mode: where the development AI server listens (npm run ai:dev).
# The iOS simulator reaches the Mac at 127.0.0.1; a phone needs the Mac's LAN address.
EXPO_PUBLIC_AI_DEV_URL=http://127.0.0.1:8787

# RevenueCat public SDK keys (not secret).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Parent consent web page and support address.
EXPO_PUBLIC_CONSENT_WEB_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# --- Server only: never prefix these with EXPO_PUBLIC_ ---
# Used by server/dev-ai.ts and the Supabase Edge Functions.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
